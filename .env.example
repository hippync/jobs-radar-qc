# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Scraping config
USER_AGENT="jobs-radar-qc/0.1 (+https://github.com/hippync/jobs-radar-qc)"
REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=5

# Enrichment agent
ANTHROPIC_API_KEY=
ENRICHMENT_MODEL=claude-haiku-4-5-20251001

# Fit-scoring agent (agents/resume_parser.py, agents/fit_scorer.py)
RESUME_PARSING_MODEL=claude-haiku-4-5-20251001
FIT_SCORING_MODEL=claude-haiku-4-5-20251001
# Local dev only — falls back to SQLite (agents/.fit_scorer_checkpoints.sqlite)
# when unset. Production (Lambda) sets this to a Postgres connection string
# instead: Supabase dashboard -> Project Settings -> Database -> Connection
# pooling -> copy the "Transaction" mode URI. Also used by
# scripts/setup_checkpointer.py and (once set) makes agents/fit_scorer.py use
# AsyncPostgresSaver instead of AsyncSqliteSaver.
FIT_SCORER_CHECKPOINT_DB=
SUPABASE_DB_URL=
# Max jobs scored per on-demand /matches request (bounds Lambda cost/latency)
MATCH_JOB_LIMIT=30

# Frontend — Next.js public vars (copy these to frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Canonical base URL for Open Graph / Twitter Card / canonical link tags.
# Set to your production domain. Falls back to https://jobs-radar-qc.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
